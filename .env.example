GEMINI_API_KEY=<your_key>
REPLICATE_API_TOKEN=<your_key>
OPENAI_API_KEY=<your_key>

# MongoDB Configuration
# Option 1: Use full connection URI (already URL-encoded)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Option 2: Use separate components (will be auto-escaped by the app)
# MONGO_USER=payador_user
# MONGO_PASSWORD=your_password_with_special_chars
# MONGO_CLUSTER=payador-cluster.dhzpzd0.mongodb.net
